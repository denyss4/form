{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@tokens": ["./packages/tokens/index.ts"],
      "@model": ["./packages/model/index.ts"],
      "@model/*": ["./packages/model/*"],
      "@copy": ["./packages/copy/copy.ts"],
      "@ui": ["./packages/ui/index.ts"],
      "@fixtures": ["./fixtures/index.ts"]
    }
  },
  "include": ["app", "packages", "fixtures", "*.ts", "*.tsx"],
  "exclude": ["node_modules", "packages/**/*.test.ts"]
}
